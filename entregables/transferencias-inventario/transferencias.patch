diff --git a/src/lib/inventory-invalidation.ts b/src/lib/inventory-invalidation.ts
new file mode 100644
index 0000000..795b53b
--- /dev/null
+++ b/src/lib/inventory-invalidation.ts
@@ -0,0 +1,16 @@
+type Listener = () => void;
+const listeners = new Map<string, Set<Listener>>();
+
+export function subscribeInventoryInvalidation(businessId: string, listener: Listener) {
+  const group = listeners.get(businessId) ?? new Set<Listener>();
+  group.add(listener);
+  listeners.set(businessId, group);
+  return () => {
+    group.delete(listener);
+    if (!group.size) listeners.delete(businessId);
+  };
+}
+
+export function invalidateInventory(businessId: string) {
+  listeners.get(businessId)?.forEach((listener) => listener());
+}
